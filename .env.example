# =========================================================================
# erpforce-indexer — environment contract (STANDALONE; no dependency on the hub repo)
#
# The service connects to Redis / OpenSearch / MySQL purely by the addresses
# below. In a shared-infra deployment these point at the same instances the hub
# uses; the indexer does not reference the hub project, network, or containers.
# =========================================================================

# --- Service ---
INDEXER_API_KEY=generate-a-random-32-byte-token   # required; openssl rand -hex 32
INDEXER_PORT=8090
SERVICE_VERSION=0.1.0

# --- Observability ---
# Logfire: logs/spans go to the console always; ALSO to Logfire cloud if a token is set.
# LOGFIRE_TOKEN=
# Langfuse (OTel span export, per-tenant tagged). All three required to enable;
# omit to disable Langfuse export (service still runs + logs to console/Logfire).
# LANGFUSE_BASE_URL=https://monit-novaforce.erpforce.ai
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Networking (how containers reach the infra) ---
# Shared infra on an existing Docker network → attach to it by name:
#   INFRA_NETWORK=<existing_network>   INFRA_NETWORK_EXTERNAL=true
# Remote/managed infra reachable by DNS/IP → leave unset (own bridge) and set the
# *_HOST / REDIS_URL below to the reachable addresses.
INFRA_NETWORK=cdc_default
INFRA_NETWORK_EXTERNAL=false

# --- Tenants (same registry pattern as the hub; values must match the live data) ---
TENANT_IDS=spar,dev_env

SPAR_APPLICATION_DB_HOST=mysql
SPAR_APPLICATION_DB_PORT=3306
SPAR_APPLICATION_DB_NAME=spar_prod_1006
SPAR_APPLICATION_DB_USER=application_db        # read-only user the INDEXER queries with
SPAR_APPLICATION_DB_PASSWORD=change-me
SPAR_APPLICATION_DB_POOL_SIZE=3
SPAR_APPLICATION_DB_MAX_OVERFLOW=7
SPAR_CDC_TOPIC_PREFIX=cdc_spar                 # MUST equal this tenant's Debezium topic.prefix
SPAR_CDC_DB_USER=debezium                       # DEBEZIUM user (needs REPLICATION SLAVE/CLIENT + SELECT)
SPAR_CDC_DB_PASSWORD=change-me

DEV_ENV_APPLICATION_DB_HOST=mysql
DEV_ENV_APPLICATION_DB_PORT=3306
DEV_ENV_APPLICATION_DB_NAME=dev_09_06_2026     # dated dev snapshot — update when it rolls over
DEV_ENV_APPLICATION_DB_USER=application_db
DEV_ENV_APPLICATION_DB_PASSWORD=change-me
DEV_ENV_APPLICATION_DB_POOL_SIZE=5
DEV_ENV_APPLICATION_DB_MAX_OVERFLOW=10
DEV_ENV_CDC_TOPIC_PREFIX=cdc_dev_env
DEV_ENV_CDC_DB_USER=debezium
DEV_ENV_CDC_DB_PASSWORD=change-me

# --- Shared infra addresses ---
# NOTE: if your Redis requires auth, the password MUST be in REDIS_URL.
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_HOST=redis                                # used by Debezium's Redis sink
REDIS_PORT=6379
REDIS_PASSWORD=change-me                        # used by Debezium's Redis sink

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_VERIFY_CERTS=false                   # true in prod (CA-signed cert)

# --- Embedding (LOCK-STEP CONTRACT #1 — model + dimension MUST match the hub) ---
LLM_CONFIG_PATH=llm_profiles.json

# --- Debezium (CDC producer — owned by this repo, generated per tenant) ---
DEBEZIUM_SNAPSHOT_MODE=no_data                  # 'initial' to backfill via CDC instead of POST /sync
DEBEZIUM_HEALTH_CHECK=true                      # indexer /health pings each tenant's Debezium
# DEBEZIUM_HEALTH_URL_TEMPLATE=http://debezium-{client_id}:8080/q/health/ready

# =========================================================================
# MySQL prerequisite (operational, not an app setting):
#   binlog_format=ROW, binlog_row_image=FULL, and a binlog retention LONGER than
#   the worst-case Debezium downtime. If binlogs are purged past Debezium's saved
#   offset, it gets stuck on "Error 1236" and silently captures nothing.
#   Recommended: binlog_expire_logs_seconds >= 604800 (7 days). See README runbook.
# =========================================================================
